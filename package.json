{
  "name": "autosnap",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "npm run build:backend && concurrently -k -n api,web \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "concurrently -k -n compile,server \"tsc -p backend/tsconfig.json --watch --preserveWatchOutput\" \"node --watch backend/dist/main.js\"",
    "dev:web": "next dev",
    "build:backend": "tsc -p backend/tsconfig.json",
    "build": "npm run build:backend && next build",
    "start": "concurrently -k -n api,web \"node backend/dist/main.js\" \"next start\"",
    "test": "npm run build && node --test tests/*.test.mjs",
    "lint": "eslint app backend/src tests",
    "db:import:d1": "node scripts/import-d1.mjs",
    "db:migrate:neon": "node scripts/migrate-pglite-to-neon.mjs",
    "db:check:neon": "node scripts/check-neon.mjs",
    "admin:reset-password": "node scripts/reset-admin-password.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@nestjs/common": "^11.2.8",
    "@nestjs/core": "^11.2.8",
    "@nestjs/platform-express": "^11.2.8",
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "pg": "^8.23.1",
    "playwright-core": "^1.64.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/express": "^5.0.6",
    "@types/node": "22.19.19",
    "@types/pg": "^8.23.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "concurrently": "^10.0.6",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
