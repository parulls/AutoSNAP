{
  "name": "autosnap",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.17.0"
  },
  "scripts": {
    "dev": "npm run build:backend && concurrently -k -n api,web \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "concurrently -k -n compile,server \"tsc -p backend/tsconfig.json --watch --preserveWatchOutput\" \"node --watch-path=backend/dist backend/dist/main.js\"",
    "dev:web": "next dev",
    "build:backend": "tsc -p backend/tsconfig.json",
    "build": "npm run build:backend && next build",
    "start": "concurrently -k -n api,web \"node backend/dist/main.js\" \"next start\"",
    "test": "npm run build && node --test --test-concurrency=1 tests/*.test.mjs",
    "lint": "eslint app backend/src tests",
    "db:inspect": "node scripts/inspect-local-db.mjs",
    "db:migrate": "npx supabase db push --remote --skip-vault",
    "db:audit:supabase": "node scripts/audit-supabase.mjs",
    "admin:reset-password": "node scripts/reset-admin-password.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.11",
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-express": "11.2.8",
    "@sparticuz/chromium": "153.0.0",
    "@types/pdfkit": "0.17.7",
    "next": "16.4.5",
    "pdfkit": "0.20.2",
    "pg": "8.23.1",
    "playwright-core": "1.64.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/express": "^5.0.6",
    "@types/node": "22.19.19",
    "@types/pg": "^8.23.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "concurrently": "^10.0.6",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.4.5",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  },
  "overrides": {
    "multer": "^2.4.1",
    "minimatch": "11.0.1"
  },
  "type": "module"
}
