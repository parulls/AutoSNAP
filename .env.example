# Supabase PostgreSQL adalah satu-satunya database runtime AutoSNAP.
# Gunakan Session Pooler (port 5432) untuk backend NestJS yang persisten.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres?uselibpqcompat=true&sslmode=require
SUPABASE_PROJECT_REF=
DATABASE_POOL_MAX=5
AUTOSNAP_API_PORT=4010
# Biarkan loopback untuk lokal. Atur 0.0.0.0 hanya pada host backend yang telah dilindungi firewall/TLS.
AUTOSNAP_API_HOST=127.0.0.1
# URL backend NestJS yang dapat dicapai frontend. Pada lokal boleh 127.0.0.1.
AUTOSNAP_API_BASE_URL=http://127.0.0.1:4010
# Wajib di produksi: secret acak minimal 32 karakter, SAMA di server frontend dan backend.
# Jangan gunakan NEXT_PUBLIC_ dan jangan tampilkan ke browser.
AUTOSNAP_INTERNAL_TOKEN=
# Batas tunggu proxy Next.js untuk satu rangkaian automation headless (10 menit).
AUTOSNAP_PROXY_TIMEOUT_MS=600000
AUTOSNAP_ENCRYPTION_KEY=
AUTOSNAP_ALLOWED_HOSTS=
AUTOSNAP_CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
AUTOSNAP_PORTAL_PROFILE_DIR=
# Batas waktu menunggu form login resmi ASPI; bukan timeout Execute API.
AUTOSNAP_PORTAL_AUTH_TIMEOUT_MS=30000
AUTOSNAP_SETUP_TOKEN=
# Google reCAPTCHA v2 Checkbox. Secret key hanya boleh berada di backend.
AUTOSNAP_RECAPTCHA_SITE_KEY=
AUTOSNAP_RECAPTCHA_SECRET_KEY=
# Pisahkan dengan koma, contoh: localhost,autosnap.bank-sumut.co.id
AUTOSNAP_RECAPTCHA_HOSTNAMES=localhost
